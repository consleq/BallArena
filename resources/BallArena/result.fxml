<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="BallArena.ui.ResultController"
      stylesheets="@styles.css"
      alignment="CENTER" spacing="30"
      prefWidth="800" prefHeight="600"
      style="-fx-background-color: #0f0f1a;">
    <padding><Insets top="40" bottom="40" left="40" right="40"/></padding>

    <Label text="遊戲結束"
           style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <Label fx:id="winnerLabel"
           style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

    <Button fx:id="backButton" text="回主選單" onAction="#onBackToMenu"
            prefWidth="200" prefHeight="50"
            styleClass="menu-button"/>
</VBox>