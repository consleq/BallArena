<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="BallArena.ui.MenuController"
      alignment="CENTER" spacing="20"
      prefWidth="800" prefHeight="600">
    <padding><Insets top="40" bottom="40" left="40" right="40"/></padding>

    <Label text="Ball Arena" style="-fx-font-size: 48px; -fx-font-weight: bold;"/>
    <Label text="選擇你的球種後開始對戰！" style="-fx-font-size: 16px;"/>
    <Button fx:id="startButton" text="開始遊戲" onAction="#onStartGame"
            prefWidth="200" prefHeight="50"
            style="-fx-font-size: 18px;"/>
</VBox>