<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="BallArena.ui.GameController"
            stylesheets="@styles.css"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #0f0f1a;">
    <center>
        <StackPane BorderPane.alignment="CENTER"
                   style="-fx-alignment: center;">
            <Canvas fx:id="gameCanvas" width="300" height="300"/>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <padding><Insets top="15" bottom="25"/></padding>
            <Label text="速度" style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;"/>
            <Button fx:id="speed1xButton" text="1x" onAction="#onSpeed1x"
                    prefWidth="60" prefHeight="36" styleClass="speed-button"/>
            <Button fx:id="speed2xButton" text="2x" onAction="#onSpeed2x"
                    prefWidth="60" prefHeight="36" styleClass="speed-button"/>
            <Button fx:id="speed4xButton" text="4x" onAction="#onSpeed4x"
                    prefWidth="60" prefHeight="36" styleClass="speed-button"/>
        </HBox>
    </bottom>
</BorderPane>
