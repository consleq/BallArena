<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="BallArena.ui.SelectController"
      stylesheets="@styles.css"
      alignment="CENTER" spacing="30"
      prefWidth="800" prefHeight="600"
      style="-fx-background-color: #0f0f1a;">
    <padding><Insets top="30" bottom="30" left="40" right="40"/></padding>

    <VBox alignment="CENTER" spacing="8">
        <Label text="隊伍選擇"
               style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="滾動右側捲軸來選擇角色"
               style="-fx-font-size: 14px; -fx-text-fill: #aaaaaa;"/>
    </VBox>

    <HBox alignment="CENTER" spacing="60">
        <!-- Player Team Selection -->
        <VBox alignment="CENTER" spacing="15">
            <Label text="玩家 (Player)" style="-fx-text-fill: #6495ED; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <StackPane fx:id="playerContainer" prefWidth="280" prefHeight="240"
                       style="-fx-background-color: #161625; -fx-background-radius: 15; -fx-border-color: #6495ED; -fx-border-radius: 15; -fx-border-width: 2;">
            </StackPane>
        </VBox>

        <!-- Enemy Team Selection -->
        <VBox alignment="CENTER" spacing="15">
            <Label text="敵方 (Enemy)" style="-fx-text-fill: #FF6347; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <StackPane fx:id="enemyContainer" prefWidth="280" prefHeight="240"
                       style="-fx-background-color: #161625; -fx-background-radius: 15; -fx-border-color: #FF6347; -fx-border-radius: 15; -fx-border-width: 2;">
            </StackPane>
        </VBox>
    </HBox>

    <HBox alignment="CENTER" spacing="30">
        <Button fx:id="startButton" text="開始戰鬥" onAction="#onStartBattle"
                prefWidth="200" prefHeight="50"
                styleClass="menu-button" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Button fx:id="backButton" text="返回主選單" onAction="#onBackToMenu"
                prefWidth="140" prefHeight="50"
                styleClass="back-button"/>
    </HBox>
</VBox>
